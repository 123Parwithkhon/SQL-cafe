# .env.example — скопируйте в .env.local и заполните. Сам .env.local в git не попадает.

# Обязательно: ключ подписи сессий. Сгенерировать: npx auth secret
AUTH_SECRET=

# Вход через Google (необязательно локально, обязательно на продакшене).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#                     и   https://ваш-домен/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# База PostgreSQL (Neon, Supabase...). Локально можно не задавать —
# тогда используется встроенная база в папке .data/. На Vercel — обязательно.
DATABASE_URL=

# Тестовый вход по имени без Google. Работает сам в `npm run dev`.
# Для `npm start` локально можно включить так. НИКОГДА не включайте на продакшене.
# AUTH_DEV_LOGIN=true
